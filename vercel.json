{
  "buildCommand": "bash build.sh",
  "outputDirectory": "public",
  "trailingSlash": true,
  "headers": [
    {
      "source": "/sitemap.xml",
      "headers": [
        { "key": "Content-Type", "value": "application/xml" }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/rebuild",
      "schedule": "0 10 * * *"
    }
  ]
}
