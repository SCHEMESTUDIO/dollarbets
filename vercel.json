{
  "buildCommand": "bash build.sh",
  "outputDirectory": "public",
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "dollarbets.lol" }],
      "destination": "https://www.dollarbets.lol/$1",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/api/login", "destination": "/api/login.py" },
    { "source": "/api/board", "destination": "/api/board.py" },
    { "source": "/go/:slug/", "destination": "/api/go.py?market=:slug" },
    { "source": "/go/:slug", "destination": "/api/go.py?market=:slug" }
  ],
  "headers": [
    {
      "source": "/sitemap.xml",
      "headers": [
        { "key": "Content-Type", "value": "application/xml" }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    }
  ]
}
