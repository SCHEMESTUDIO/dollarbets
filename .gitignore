# Cloud-session workaround dir for stale .git/*.lock files the VM cannot
# unlink. Committed by accident in the dogshow repo (c0f3a77) and, because it
# was not in .vercelignore either, served stale duplicate copies of six real
# pages at /_to_delete/restage/* until 2026-08-22. It will keep reappearing —
# keep it ignored. See Postwerks link-rail-handover.md.
_to_delete/

public/
node_modules/
.vercel/
__pycache__/
*.pyc
.DS_Store
markets.json
.fonts/
!public/favicon*
!public/apple-touch-icon.png
!public/android-chrome-*
sports_stderr.log
# Local dev settings — may contain accidentally-captured secrets in Bash allowlist entries
.claude/settings.local.json
.env
.env.*
!.env.example
# Local debug / network-trace dumps — contain IPs, hostnames, system usernames
vercel-debug.txt
*.debug
*.log
*.bak
*.orig
*.tmp
# Local credentials never checked in
credentials.json
secrets.json
data/corpus/
data/corpus/

# CI scratch (Telegram report files etc.)
.ci/
